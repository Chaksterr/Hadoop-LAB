# ZooKeeper 3.8.5 Configuration
# Reference: https://zookeeper.apache.org/doc/r3.8.5/zookeeperAdmin.html

# The number of milliseconds of each tick
tickTime=2000

# The number of ticks that the initial synchronization phase can take
initLimit=10

# The number of ticks that can pass between sending a request and getting an acknowledgement
syncLimit=5

# The directory where the snapshot is stored
dataDir={{ zookeeper_data_dir }}

# The port at which the clients will connect
clientPort={{ zookeeper_client_port }}

# Bind to all network interfaces (accessible from host machine)
clientPortAddress=0.0.0.0

# The maximum number of client connections
maxClientCnxns=60

# Admin server configuration (port 8080 by default, used for Web UI)
admin.enableServer=true
admin.serverPort={{ zookeeper_admin_port }}
admin.serverAddress=0.0.0.0

# Autopurge configuration (clean old snapshots)
autopurge.snapRetainCount=3
autopurge.purgeInterval=1

# ZooKeeper ensemble configuration
# Format: server.X=hostname:peerPort:leaderPort
server.1=master:{{ zookeeper_peer_port }}:{{ zookeeper_leader_port }}
server.2=standby:{{ zookeeper_peer_port }}:{{ zookeeper_leader_port }}
server.3=datanode1:{{ zookeeper_peer_port }}:{{ zookeeper_leader_port }}
